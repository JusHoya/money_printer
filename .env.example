# Money Printer — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it
# must never contain a real key, and it must never carry a value that would be
# wrong in production (see NWS_STATION_ID below).
#
#   cp .env.example .env


# ---------------------------------------------------------------------------
# Kalshi API
# ---------------------------------------------------------------------------
# Production is the ONLY valid endpoint for price reads:
#   https://api.elections.kalshi.com/trade-api/v2
# The demo sandbox (https://demo-api.kalshi.co/trade-api/v2) has empty
# orderbooks; api.kalshi.co and trading-api.kalshi.com are defunct.
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_KEY_ID=your-key-id-here

# Path to the RSA private key file used to sign requests. Either this or
# KALSHI_PRIVATE_KEY (the key contents inline) must be set.
KALSHI_PRIVATE_KEY_PATH=kalshi_priv.key
# KALSHI_PRIVATE_KEY=


# ---------------------------------------------------------------------------
# National Weather Service
# ---------------------------------------------------------------------------
# api.weather.gov requires a contact string in the User-Agent header.
NWS_USER_AGENT=(MoneyPrinter_Bot, your_email@example.com)

# OPTIONAL observation-station override — LEAVE IT UNSET unless you have a
# reason not to.
#
# PRD FR-1.4 / Phase 1 exit criterion 6: Kalshi settles each daily-high market
# on ONE specific station, and no non-settlement value may reach a strategy
# input. The value is validated against the city registry
# (src/bots/weather_bot.py); only these four are accepted:
#
#     KNYC  -> KXHIGHNY    New York, Central Park
#     KMDW  -> KXHIGHCHI   Chicago Midway
#     KLAX  -> KXHIGHLAX   Los Angeles International
#     KMIA  -> KXHIGHMIA   Miami International
#
# A nearby airport is NOT the settlement station: measured against the IEM
# archive it runs up to 3F above Central Park on a daily high, enough to flip
# a 2F-wide bracket on about half of all days. Setting one here aborts the
# run (abort-on-missing-critical-input) rather than reporting a confident,
# wrong result. Unset, the weather bot observes all four settlement stations
# and `scripts/simulate.py --live` observes KNYC.
# NWS_STATION_ID=KNYC


# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# Discord webhook for cycle summaries, staleness alerts and settlement
# mismatches. Unset = notifications disabled.
# DISCORD_WEBHOOK_URL=


# ---------------------------------------------------------------------------
# Runtime (optional)
# ---------------------------------------------------------------------------
# Starting simulated balance in USD. Default 3000.
# MP_SIM_BALANCE=3000

# Set to 1 to stop the VM watchdog writing its own log file.
# VM_WATCHDOG_NO_FILELOG=

# Only needed by the Hermes monitoring agent, not by the trading runtime.
# ANTHROPIC_API_KEY=
