[Unit]
Description=Weekly lab-vs-paper reconcile, Monday 14:30 UTC (after maia's daily 13:30Z mp-reconcile-weather.timer)

[Timer]
# docs/factory/F3_RUNBOOK.md section 5: "weekly (Monday, after the daily
# reconcile)". maia settles the previous week's last city-days by its 13:30Z
# daily run; an hour later every settled row that week can produce is in the
# journal, and the reconcile window (previous Monday .. Sunday, computed by
# factory_reconcile.sh) is closed.
OnCalendar=Mon *-*-* 14:30:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
